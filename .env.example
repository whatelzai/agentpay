# AgentPay environment variables
# Copy this file to .env.local and fill in values

# Public base URL — used by the MCP server to build confirmation URLs
# Defaults to https://agentpay-tan.vercel.app if unset (production Vercel URL).
# Override for local dev: NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# StraitsX MCP endpoints (Dev Hub provided) — used from phase 3
# STRAITSX_SANDBOX_MCP_URL=https://card.straitsx.ai/sandbox/sse
# STRAITSX_PRODUCTION_MCP_URL=https://card.straitsx.ai/production/sse
# STRAITSX_MCP_PASSPHRASE=  # per-team, from Dev Hub

# Avalanche RPC (public) — used from phase 3
# AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
