# AgentPay environment variables
# For local development, copy this file to .env.local. Never commit real keys.

# Public URL used to build confirmation links.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Payment architecture. Safe defaults are shown below.
# - user_wallet: each user signs and funds their own exact XSGD authorization.
# - platform_wallet: one shared demo treasury pays, so only DEMO_OWNER_ADDRESS
#   may sign Confirmations.
AGENTPAY_PAYMENT_RAIL=straitsx
AGENTPAY_FUNDING_MODE=user_wallet

# StraitsX target. The application defaults to sandbox unless production is
# explicitly selected.
STRAITSX_ENV=sandbox

# Required to keep reusable payment signatures away from the untrusted agent.
# Generate once per deployment with: openssl rand -hex 32
# Set the same value on every instance that serves and executes capabilities.
# Never prefix this variable with NEXT_PUBLIC_.
# CONFIRMATION_SEALING_KEY=64 lowercase hex characters

# Optional smart-wallet Confirmation verification through ERC-1271. This does
# not change the StraitsX EIP-3009 requirement: that payment proof must still be
# an ECDSA signature from the XSGD payer address.
# AGENTPAY_ENABLE_ERC1271=true
# AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Independent Block Receipt signer. A raw key is acceptable only for local or
# hackathon use. Production should replace this adapter with KMS/HSM signing.
# If unset, receipts are recorded as degraded and unsigned.
# RECEIPT_SIGNER_PRIVATE_KEY=0x-prefixed, 64 hex chars

# Platform-funded DEMO mode only. Never set these for user_wallet mode.
# AGENTPAY_FUNDING_MODE=platform_wallet
# DEMO_OWNER_ADDRESS=0x-prefixed wallet address
# STRAITSX_PAYER_PRIVATE_KEY=0x-prefixed, 64 hex chars

# Legacy aliases accepted during migration. Do not use in new deployments.
# OWNER_ADDRESS=0x-prefixed wallet address
# WALLET_PRIVATE_KEY=0x-prefixed, 64 hex chars

# StraitsX MCP transport is not used by the direct x402 card adapter. Keep these
# unset unless an MCP-specific integration is added.
# STRAITSX_SANDBOX_MCP_URL=https://card.straitsx.ai/sandbox/sse
# STRAITSX_PRODUCTION_MCP_URL=https://card.straitsx.ai/production/sse
# STRAITSX_MCP_PASSPHRASE=

# Crossmint is an optional future wallet/payment adapter. Do not add Crossmint
# API or signer secrets until that adapter is enabled and Avalanche access is
# confirmed for the project.
